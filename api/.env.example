# Server-side provider keys. These are ONLY spent on incoming requests when
# COUNSELREFLECT_ALLOW_SERVER_KEYS=true; by default callers must supply their
# own key with each request.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
REPLICATE_API_TOKEN=
PERSPECTIVE_API_KEY=

# When false (default), the backend never spends the provider keys above on
# incoming requests. Set to true only for a private, access-gated deployment
# that should cover usage from its own keys.
COUNSELREFLECT_ALLOW_SERVER_KEYS=false

COUNSELREFLECT_ACCESS_REQUIRED=false
COUNSELREFLECT_ACCESS_TOKEN=

# How many evaluations may run at the same time (default 2). Requests past
# the cap get an immediate 429; size this to roughly half the host's vCPUs.
COUNSELREFLECT_MAX_CONCURRENT_EVALUATIONS=2

# HF Inference Endpoint URLs for the classifier metrics (talk_type,
# emotional_support_strategy, pair, reccon). Deploy the models as HF
# Inference Endpoints and set the URLs here; each metric is unavailable
# until its URL is configured.
TALK_TYPE_ENDPOINT_URL=
EMOTIONAL_SUPPORT_STRATEGY_ENDPOINT_URL=
PAIR_ENDPOINT_URL=
RECCON_ENDPOINT_URL=
# Token used to authenticate to the endpoints above when they are protected.
HF_ENDPOINT_TOKEN=
MEDRAG_CORPUS=./corpus
MEDSCORE_TIMEOUT_SECONDS=300
STREAM_HEARTBEAT_SECONDS=15

# Feedback email (SMTP)
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=
FEEDBACK_SMTP_USERNAME=
FEEDBACK_SMTP_PASSWORD=
FEEDBACK_SMTP_USE_TLS=
FEEDBACK_SMTP_USE_SSL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_TO_EMAIL=
