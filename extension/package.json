{
  "name": "@counselreflect/extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:preview": "tsc --noEmit -p tsconfig.json && vite build --watch --mode preview",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:preview": "tsc --noEmit -p tsconfig.json && vite build --mode preview",
    "test": "node --test --test-reporter=./tests/repo-relative-reporter.mjs tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
