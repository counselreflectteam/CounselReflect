# Copy to .env.preview and replace only the public backend URL.
# Every VITE_* value is visible in the extension bundle. Never add provider keys
# or the preview access code here.
VITE_API_BASE_URL=https://your-preview-host.example/api
VITE_SERVER_MANAGED_ONLY=false
VITE_REQUIRE_ACCESS_CODE=true
VITE_DEFAULT_PROVIDER=openai
VITE_DEFAULT_MODEL=gpt-4.1
