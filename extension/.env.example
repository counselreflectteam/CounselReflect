# API Base URL for the FastAPI backend, baked into the bundle at build time.
#
# Vite loads env files per mode:
#   npm run build          (production mode) -> .env.production
#   npm run build:preview  (preview mode)    -> .env.preview
#   npm run dev            (development mode)-> .env.development.local
#
# These mode-specific files are gitignored. Start from the corresponding
# committed .example file and keep provider keys and access codes on the server.
#
# Example .env.development.local for a local backend:
VITE_API_BASE_URL=http://localhost:8000

# Preview-only safety switches. Every VITE_* value is public bundle metadata;
# never put an access code or provider key here.
# server-managed=false: users supply their own provider keys (the backend
# does not spend server-side keys unless COUNSELREFLECT_ALLOW_SERVER_KEYS=true).
VITE_SERVER_MANAGED_ONLY=false
VITE_REQUIRE_ACCESS_CODE=true
