# CLI Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# Backend API URL (default: http://localhost:8000)
BACKEND_URL=http://localhost:8000
# Evaluation HTTP timeout in seconds (default: 900 / 15 minutes)
EVALUATION_TIMEOUT=900
# Required when the backend access gate is enabled
COUNSELREFLECT_ACCESS_TOKEN=

# Optional when the backend already has this provider key
OPENAI_API_KEY=

# Required only by selected metrics that declare requiresHf, and optional when
# the backend already has an HF credential.
HUGGINGFACE_API_KEY=
# Alternative name (both work):
# HF_TOKEN=
# HF_API_KEY=
